# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-long-random-string

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./rfid_lab.db
# PostgreSQL: DATABASE_URL=postgresql://user:pass@localhost:5432/rfid_lab

# ── Google Drive ───────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_DRIVE_ACCOUNT=searlabuta@gmail.com

# Zebra Scans folder  (get ID from Drive URL: drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_ZEBRA_FOLDER_ID=1RqCFbZ7OJsayL25gfmXXXu3Rf7zgmbug

# ItemTest Scans folder
GOOGLE_DRIVE_IMPINJ_FOLDER_ID=1nfBHmpui9mWaXiihO9-O37jYEJj0UiTc

# How often to poll Drive (seconds)
DRIVE_POLL_INTERVAL=30

# ── RFID Scanner push ──────────────────────────────────────────────────────
RFID_SCANNER_PUSH_ENABLED=true
RFID_SCANNER_API_KEY=rfid-scanner-secret-key

# ── MQTT (Eclipse Mosquitto) ───────────────────────────────────────────────
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=lab/rfid

# ── Impinj Octane SDK reader service ──────────────────────────────────────
RFID_READER_ENABLED=false
IMPINJ_READER_HOST=192.168.1.100
RSSI_THRESHOLD=-75

# ── Lab info ───────────────────────────────────────────────────────────────
LAB_NAME=SEARLab UTA
SYSTEM_VERSION=2025/26
IMPINJ_READER_ID=impinj-r700-lab01
MC3300R_READER_ID=mc3300r-lab01
